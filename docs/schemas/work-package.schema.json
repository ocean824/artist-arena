{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-arena.invalid/schemas/work-package.schema.json",
  "title": "Artist Arena Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticketId",
    "requirementIds",
    "objective",
    "scope",
    "dependencies",
    "affectedPaths",
    "acceptanceCriteria",
    "requiredTests",
    "evidence",
    "rollback",
    "activationEffect"
  ],
  "properties": {
    "ticketId": {
      "type": "string",
      "pattern": "^AA-[0-9]{4}$"
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AA-[A-Z]+-[0-9]{3}$"
      }
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AA-[0-9]{4}$"
      }
    },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "requiredTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 10
    },
    "activationEffect": {
      "type": "string",
      "minLength": 3
    }
  }
}
