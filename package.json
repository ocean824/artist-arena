{
  "name": "artist-arena",
  "version": "0.0.0",
  "private": true,
  "description": "Competitive infrastructure for the global creator economy",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
